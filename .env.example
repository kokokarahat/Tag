# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------
# Leave Supabase blank to use the JSON file fallback (`.data/portal-events.json`).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Password for the /admin console. In production this is required — when it is
# missing the console refuses every login instead of using the demo default.
ADMIN_PASSWORD=TagAdmin2026

# ---------------------------------------------------------------------------
# Deposit wallets (server-side only, rendered on /deposit-methods)
# ---------------------------------------------------------------------------
# Leave a value blank to show a "contact support" placeholder for that coin.
DEPOSIT_WALLET_BTC=
DEPOSIT_WALLET_ETH=
DEPOSIT_WALLET_USDT=
DEPOSIT_WALLET_USDC=
DEPOSIT_WALLET_BNB=
DEPOSIT_WALLET_SOL=

# ---------------------------------------------------------------------------
# Public values (safe to expose to the browser)
# ---------------------------------------------------------------------------
# Only needed if you later add browser-side Supabase calls.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Cloudflare (used by `npm run cf:build` / `npm run cf:preview` / deploy)
# ---------------------------------------------------------------------------
# The Cloudflare account id is read by Wrangler from the environment or from
# `wrangler.jsonc`. Never commit real values.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
